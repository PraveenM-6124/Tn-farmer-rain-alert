# ==============================================================================
# Tamil Nadu Farmer Rain Alert & Marketplace - Environment Configuration
# ==============================================================================
# DO NOT COMMIT SENSITIVE SECRETS OR REAL CREDENTIALS.
# Copy this file to .env for local development.

# Application Environment
ENV=development
DEBUG=true
APP_NAME="Tamil Nadu Farmer Rain Alert & Marketplace"
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-this-in-production-use-a-strong-secret-key-min-32-chars

# Database (PostgreSQL + PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tn_farmer_weather
# If DATABASE_URL is provided, it takes precedence. Note: SQLite is supported for local lightweight testing.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tn_farmer_weather

# Security & Session
SESSION_COOKIE_NAME=tn_farmer_session
SESSION_SECRET=dev-session-secret-change-me

# Language & Localization
DEFAULT_LANGUAGE=ta
SUPPORTED_LANGUAGES=ta,en
TIMEZONE=Asia/Kolkata

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# --- PLACEHOLDERS FOR FUTURE PHASES (Empty / Mock Defaults) ---
WEATHER_PROVIDER=mock
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
IMD_API_URL=

SMS_PROVIDER=mock
SMS_DLT_ENTITY_ID=
SMS_DLT_SENDER_ID=
SMS_API_KEY=

WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

REDIS_URL=redis://localhost:6379/0
